FROM --platform=linux/amd64 condaforge/miniforge3
ARG python
ARG version
RUN conda config --add channels conda-forge && \
    conda config --set channel_priority strict

# Create conda environment with yggdrasil installed
RUN conda create -n env python=$python yggdrasil=$version yggdrasil.c yggdrasil.fortran yggdrasil.r yggdrasil.zmq yggdrasil.mpi yggdrasil.rmq yggdrasil.testing yggdrasil.docs yggdrasil.dev -y

# Required so that gcc & g++ are available as paths in OpenSimRoot make
RUN conda run -n env cp $CC $(dirname $CC)/gcc && \
    conda run -n env cp $CXX $(dirname $CXX)/g++

# Configure yggdrasil
RUN conda run -n yggconfig && \
    conda run -n ygginfo --verbose

# Compile interfaces
RUN conda run -n yggcompile c cpp

WORKDIR /home
# RUN echo "conda activate env" > ~/.bashrc
# CMD ["/bin/bash", "--login"]
