ARG platform
FROM --platform=linux/$platform condaforge/miniforge3
ARG python
ARG sourcedir
RUN apt-get --allow-releaseinfo-change update -y
RUN conda config --add channels conda-forge && \
    conda config --set channel_priority strict

# Copy local repository
COPY $sourcedir /yggdrasil/
COPY *.py /yggdrasil/utils/
COPY requirements/ /yggdrasil/utils/requirements/
RUN ls /yggdrasil/*
WORKDIR /yggdrasil

# Create environment
RUN python utils/setup_test_env.py env --env-name=env conda $python

# Install dependencies
RUN conda run -n env python utils/setup_test_env.py deps conda --for-devlopment --always-yes --no-sudo --python-only --install-mpi --install-rmq --install-sbml --install-omp --install-zmq --install-r --dont-install-dev
RUN conda install -n env -y c-compiler cxx-compiler

# Install yggdrasil
RUN conda run -n env python -m pip install -e .
# RUN conda run -n env python utils/setup_test_env.py install conda --for-development --always-yes --no-sudo --python-only  --without-deps --build-method=direct

# Configure yggdrasil
RUN conda run -n env yggconfig && \
    conda run -n env ygginfo --verbose

# Compile interfaces
RUN conda run -n env yggcompile c cpp

WORKDIR /home
# RUN echo "conda activate env" > ~/.bashrc
# CMD ["/bin/bash", "--login"]
