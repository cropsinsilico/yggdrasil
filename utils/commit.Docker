ARG platform
FROM --platform=linux/$platform condaforge/miniforge3
ARG python
ARG commit
RUN apt-get --allow-releaseinfo-change update -y
RUN conda config --add channels conda-forge && \
    conda config --set channel_priority strict

# Clone selected commit
RUN git clone --recurse-submodules https://github.com/cropsinsilico/yggdrasil.git && \
    cd yggdrasil && \
    git checkout $commit && \
    git submodule update --recursive
WORKDIR /yggdrasil

# Create environment
RUN python utils/setup_test_env.py env --env-name=env conda $python

# Install dependencies
RUN conda run -n env python utils/setup_test_env.py deps conda --for-development --always-yes --no-sudo --python-only --install-mpi --install-rmq --install-sbml --install-omp
RUN conda install -n env -y c-compiler cxx-compiler

# Install yggdrasil
RUN conda run -n env python -m pip install -e .
# RUN conda run -n env python utils/setup_test_env.py install conda --for-development --always-yes --no-sudo --python-only --install-mpi --install-rmq --install-sbml --install-omp --without-deps --build-method=direct

# Configure yggdrasil
RUN conda run -n env yggconfig && \
    conda run -n env ygginfo --verbose

# Compile interfaces
RUN conda run -n env yggcompile c cpp

WORKDIR /home
# RUN echo "conda activate env" > ~/.bashrc
# CMD ["/bin/bash", "--login"]
